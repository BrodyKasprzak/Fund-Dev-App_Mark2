rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == "admin";
    }

    function docIsRestricted(docData) {
      return ("docAccessMode" in docData) && docData.docAccessMode == "restricted";
    }

    function docAllowsMember(docData) {
      return ("docAllowedMemberUids" in docData) && request.auth.uid in docData.docAllowedMemberUids;
    }

    function canReadOrgDocument(orgId, docData) {
      return isOrgAdmin(orgId) || (isOrgMember(orgId) && (!docIsRestricted(docData) || docAllowsMember(docData)));
    }

    // Users: allow user to read + write their own doc (so orgId can be set client-side if you want)
    match /users/{uid} {
      allow read: if isSelf(uid);

      // Allow create/update for self, but prevent setting/changing authz fields.
      allow create, update: if isSelf(uid)
        && !( "orgId" in request.resource.data )
        && !( "role" in request.resource.data );

      allow delete: if false;
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);

      // optional: allow admin to update org profile fields from the UI
      allow update: if isOrgAdmin(orgId);
      allow create, delete: if false;

      // Membership subcollection
      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);

        // Only admin can add/remove members (invites flow usually server does this)
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      // Subcollections: members can read/write their org content (adjust as desired)
      match /plans/{planId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /invites/{inviteId} {
        allow read, write: if isOrgAdmin(orgId);
      }

      match /documents/{docId} {
        allow read: if canReadOrgDocument(orgId, resource.data);
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
